{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cqa",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-W",
        "ignore",
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "prototype"
      ],
      "port": 8765
    }
  ]
}